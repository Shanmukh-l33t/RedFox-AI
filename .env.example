# Copy to .env (never commit it) and load before running.

# ---- LLM -------------------------------------------------------------------
# openai | anthropic | ollama
REDFOX_LLM_PROVIDER=ollama
REDFOX_LLM_MODEL=qwen2.5:3b-instruct
REDFOX_LLM_BASE_URL=http://127.0.0.1:11434/v1
# REDFOX_LLM_API_KEY=...            # required for openai/anthropic, unused by ollama
# REDFOX_LLM_MAX_TOKENS=2048
# REDFOX_LLM_TIMEOUT=300            # raise for slow local models

# ---- Safety and limits -----------------------------------------------------
# REDFOX_RATE_PER_MIN=120
# REDFOX_RATE_PER_TARGET=60
# REDFOX_QUIET_HOURS=22:00-06:00
# REDFOX_MAX_STEPS=40
# REDFOX_TOOL_TIMEOUT=600

# ---- Paths -----------------------------------------------------------------
# REDFOX_HOME=~/.redfox
# REDFOX_TOOLS_DIR=./tools/bin