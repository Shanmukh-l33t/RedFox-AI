    {
      "tool": {
        "driver": {
          "name": "RedFox AI",
          "version": "0.1.0",
          "informationUri": "https://github.com/Shanmukh-l33t/RedFox-AI",
          "rules": [
            {
              "id": "codeigniter-env",
              "name": "Codeigniter - .env File Discovery",
              "shortDescription": {
                "text": "Codeigniter - .env File Discovery"
              },
              "fullDescription": {
                "text": "Codeigniter .env file was discovered."
              },
              "help": {
                "text": ""
              },
              "properties": {
                "severity": "high",
                "security-severity": "8.0"
              }
            },
            {
              "id": "generic-env",
              "name": "Exposed .env file",
              "shortDescription": {
                "text": "Exposed .env file"
              },
              "fullDescription": {
                "text": "Nuclei matched the generic-env template against http://lab.internal:8080/.env, indicating that an environment configuration file may be publicly accessible. Such files commonly contain credentials, API keys, database connection strings, or other sensitive configuration."
              },
              "help": {
                "text": "Remove the .env file from the web-accessible document root, block access to dotfiles and environment files at the web server/proxy layer, and rotate any secrets that may have been exposed."
              },
              "properties": {
                "severity": "high",
                "security-severity": "8.3"
              }
            },
            {
              "id": "git-config",
              "name": "Git Configuration - Detect",
              "shortDescription": {
                "text": "Git Configuration - Detect"
              },
              "fullDescription": {
                "text": "Git configuration was detected via the pattern /.git/config and log file on passed URLs."
              },
              "help": {
                "text": ""
              },
              "properties": {
                "severity": "medium",
                "security-severity": "5.3"
              }
            },
            {
              "id": "apache-server-status",
              "name": "Apache Server Status Disclosure",
              "shortDescription": {
                "text": "Apache Server Status Disclosure"
              },
              "fullDescription": {
                "text": "Apache /server-status displays information about your Apache status. If you are not using this feature, disable it."
              },
              "help": {
                "text": ""
              },
              "properties": {
                "severity": "low",
                "security-severity": "2.5"
              }
            }
          ]
        }
      },
